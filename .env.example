# Copia este archivo como .env y rellena lo que quieras. TODO es opcional.

# --- Inteligencia artificial (Claude) ---
# Sin clave, MyFeed clasifica y entiende tus comandos con reglas propias.
# Con clave: resúmenes en español, ideas clave, mejor clasificación y comandos más finos.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = rápido y barato; medium/high = más cuidadoso
CLAUDE_EFFORT=low
# Tope diario de ítems analizados por Claude (controla el gasto)
CLAUDE_DAILY_ITEM_LIMIT=300

# --- YouTube Data API v3 (gratis, 10 000 unidades/día) ---
# Sin clave se usan los RSS públicos de los canales que sigues.
# Con clave: duraciones exactas (cortos vs largos), búsquedas por tema y descubrimiento de creadores.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_SEARCH_LIMIT=20

# --- Seguridad ---
# Si expones la API fuera de tu casa, pon un token largo y escríbelo también en la app.
APP_TOKEN=
POSTGRES_PASSWORD=myfeed

# --- Otros ---
TIMEZONE=America/Bogota
DISCOVERY_INTERVAL_MINUTES=90
API_PORT=8000
